# -----------------------------------------------------------------------------
# ComplianceOS AI Backend - Environment Variables
# -----------------------------------------------------------------------------

PROJECT_NAME="ComplianceOS AI API"
ENV=development

# Database Settings
# Note: For production use a secret password, e.g. postgres+asyncpg://user:pass@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/complianceos"

# Cache Settings
REDIS_URL="redis://localhost:6379/0"

# Vector DB Settings
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# API Core Settings
API_V1_STR="/api/v1"
SECRET_KEY="temporary-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# External Services
OPENROUTER_API_KEY="your-openrouter-api-key"
CLERK_SECRET_KEY="your-clerk-secret-key"

# CORS Origins
# Must be a JSON list of strings
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'
