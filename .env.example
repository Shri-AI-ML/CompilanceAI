# -----------------------------------------------------------------------------
# ComplianceOS AI - Global Environment Variables Template
# -----------------------------------------------------------------------------

# Project Environment
NODE_ENV=development
PROJECT_NAME="ComplianceOS AI"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/complianceos"

# Cache Configuration (Redis)
REDIS_URL="redis://localhost:6379/0"

# Vector DB Configuration (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# AI / LLM API Configuration (OpenRouter)
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Authentication Configuration (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key-here"
CLERK_SECRET_KEY="your-clerk-secret-key-here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Backend API Settings
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'
API_V1_STR="/api/v1"
